{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentStudio Canonical Agent Schema v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "model", "instructions"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "agentstudio/v1",
      "description": "API Schema version"
    },
    "kind": {
      "type": "string",
      "const": "Agent",
      "description": "Resource kind"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique slug of the agent (kebab-case)"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version of the agent (e.g. 1.0.0)"
        },
        "description": {
          "type": "string",
          "description": "Natural language summary of agent purpose"
        },
        "framework": {
          "type": "string",
          "description": "Underlying framework (e.g., native_agentos, langchain, crewai)"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "name"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "google", "ollama", "openrouter"]
        },
        "name": {
          "type": "string"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "name"],
            "properties": {
              "provider": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "routing": {
          "type": "object",
          "properties": {
            "maxCostPerRun": { "type": "number" },
            "maxLatencyMs": { "type": "integer" },
            "dataResidency": { "type": "string" }
          }
        }
      }
    },
    "instructions": {
      "type": "string",
      "description": "System prompt instructions for the agent"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["mcp", "http", "native"] },
          "server": { "type": "string" },
          "tool": { "type": "string" },
          "url": { "type": "string" },
          "version": { "type": "string" },
          "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"], "default": "low" },
          "permissions": {
            "type": "object",
            "properties": {
              "egress": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["llm", "tool", "condition", "parallel", "loop", "retry", "human_approval", "subagent", "input", "output"]
              },
              "label": { "type": "string" },
              "toolRef": { "type": "string" },
              "config": { "type": "object" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "condition": { "type": "string" }
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "policyBundle": { "type": "string" },
        "approval": {
          "type": "object",
          "properties": {
            "highRiskToolCalls": { "type": "string", "enum": ["required", "log", "auto"], "default": "required" },
            "criticalRiskToolCalls": { "type": "string", "enum": ["block", "required"], "default": "block" }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxCostPerRun": { "type": "number", "minimum": 0 },
        "maxTokensPerRun": { "type": "integer", "minimum": 1 },
        "maxRunsPerDay": { "type": "integer", "minimum": 1 },
        "dailyLimit": { "type": "number", "minimum": 0 }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "sandbox": { "type": "string", "enum": ["none", "docker", "gvisor", "firecracker"], "default": "docker" },
        "egress": { "type": "string", "enum": ["open", "restricted", "none"], "default": "restricted" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 120 },
        "maxToolCalls": { "type": "integer", "minimum": 1, "default": 20 },
        "maxDepth": { "type": "integer", "minimum": 1, "default": 4 },
        "maxOutputBytes": { "type": "integer" },
        "maxConcurrentRuns": { "type": "integer" }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ephemeral", "persistent", "semantic"], "default": "ephemeral" },
        "maxTokens": { "type": "integer" }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "traceLevel": { "type": "string", "enum": ["minimal", "standard", "debug"], "default": "standard" },
        "redactPrompts": { "type": "boolean", "default": true }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["secretRef"],
            "properties": {
              "secretRef": { "type": "string", "pattern": "^secret://.+" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["webhook", "schedule"] },
          "cron": { "type": "string" }
        }
      }
    },
    "sandboxTests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "input", "expectedBehavior"],
        "properties": {
          "name": { "type": "string" },
          "input": { "type": "string" },
          "expectedBehavior": { "type": "string" }
        }
      }
    }
  }
}
